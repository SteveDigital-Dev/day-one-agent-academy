AA_DATABASE_URL=sqlite+aiosqlite:///./agent_academy.db
# Placeholder - fine ONLY because AA_DEBUG=true below. app/config.py refuses
# to start with this value once AA_DEBUG=false. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AA_SECRET_KEY=change-me-to-a-real-random-secret-value-please
AA_AI_PROVIDER=ollama
AA_OLLAMA_BASE_URL=http://localhost:11434
AA_OLLAMA_MODEL=qwen3:4b
AA_DEBUG=true
# Comma-separated allowed frontend origins for CORS. Default below matches
# the documented Vite dev port - override for any real deployment.
AA_CORS_ORIGINS=http://localhost:5173
